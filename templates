<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ArabOSINT - أداة الاستخبارات المفتوحة</title>
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #121212; color: #ffffff; margin: 0; padding: 0; display: flex; justify-content: center; align-items: center; min-height: 100vh; }
        .container { background-color: #1e1e1e; padding: 30px; border-radius: 12px; box-shadow: 0 8px 16px rgba(0,0,0,0.5); width: 100%; max-width: 700px; }
        h1 { color: #00ffcc; text-align: center; margin-bottom: 5px; }
        p.subtitle { text-align: center; color: #aaaaaa; margin-bottom: 25px; font-size: 14px; }
        .disclaimer { background-color: #332b00; border-right: 5px solid #ffcc00; padding: 15px; margin-bottom: 20px; font-size: 13px; color: #ffdd44; border-radius: 4px; line-height: 1.5; }
        label { display: block; margin-bottom: 8px; color: #dddddd; font-weight: bold; }
        select, input { width: 100%; padding: 12px; margin-bottom: 20px; border: 1px solid #333333; border-radius: 6px; background-color: #2a2a2a; color: #ffffff; font-size: 15px; box-sizing: border-box; outline: none; }
        select:focus, input:focus { border-color: #00ffcc; }
        button { width: 100%; padding: 14px; background-color: #00b38f; border: none; border-radius: 6px; color: #ffffff; font-size: 16px; font-weight: bold; cursor: pointer; transition: background-color 0.3s ease; }
        button:hover { background-color: #00ffcc; color: #121212; }
        pre { background-color: #0d0d0d; border: 1px solid #333333; padding: 15px; border-radius: 6px; overflow-x: auto; white-space: pre-wrap; font-family: 'Courier New', Courier, monospace; min-height: 120px; margin-top: 20px; color: #00ff00; direction: ltr; text-align: left; }
        .loader { display: none; text-align: center; color: #00ffcc; margin-top: 15px; font-weight: bold; }
    </style>
</head>
<body>
    <div class="container">
        <h1>ArabOSINT</h1>
        <p class="subtitle">منصة الاستخبارات المفتوحة الموحدة</p>
        
        <div class="disclaimer">
            <strong>تنبيه أخلاقي وقانوني:</strong> هذا المشروع تم تطويره لأغراض الأبحاث الأمنية، واختبار الاختراق الأخلاقي، والتحقيقات المصرح بها فقط. الاستخدام غير المصرح به ضد أفراد أو جهات يعتبر انتهاكاً للخصوصية ومخالفاً للقانون.
        </div>

        <label for="tool">اختر نوع الاستهداف:</label>
        <select id="tool">
            <option value="sherlock">البحث عن اسم مستخدم (Username) - عبر Sherlock</option>
            <option value="holehe">البحث عن حسابات مرتبطة بإيميل (Email) - عبر Holehe</option>
            <option value="phone">تحليل بيانات رقم هاتف (Phone Number) - عبر Phonenumbers</option>
        </select>

        <label for="target">أدخل الهدف:</label>
        <input type="text" id="target" placeholder="اكتب اليوزر، الإيميل، أو رقم الهاتف (مع رمز الدولة +)...">

        <button onclick="runTool()">بدء الفحص</button>
        <div class="loader" id="loader">جاري الفحص واستخراج البيانات، يرجى الانتظار...</div>

        <pre id="output">النتائج ستظهر هنا...</pre>
    </div>

    <script>
        async function runTool() {
            const target = document.getElementById('target').value;
            const tool = document.getElementById('tool').value;
            const output = document.getElementById('output');
            const loader = document.getElementById('loader');
            
            if (!target) {
                alert("الرجاء إدخال الهدف أولاً.");
                return;
            }

            output.textContent = '';
            loader.style.display = 'block';
            
            try {
                const response = await fetch('/api/search', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ target, tool })
                });
                const data = await response.json();
                loader.style.display = 'none';
                output.textContent = data.result || data.error;
            } catch (err) {
                loader.style.display = 'none';
                output.textContent = 'حدث خطأ في الاتصال بالسيرفر المحلي.';
            }
        }
    </script>
</body>
</html>